# ===========================================================
# Rotula - Environment Variables
# ============================================================
#
# Copy this file to `.env.local` and fill in the values.
# Variables are validated at build time by `src/lib/config/`.
# A missing or malformed required variable fails `npm run build` with a
| message naming the variable.
#
# Public variables (prefixed with NEXT_PUBLIC_) are bundled into the
# client and must NEVER contain secrets.
# Server-only variables are only readable from server code.

# ------------------------------------------------------------------------
# Public variables (safe to expose to the browser)
# ------------------------------------------------------------------------

# Stellar network to target. One of: testnet | mainnet.
# Required. Used to select the Horizon endpoint and explorer links.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Base URL of the Stellar Horizon API.
# Required. Must be a valid http(s) URL.
# Testnet: https://horizon-testnet.stellar.org
# Mainnet:  https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# ------------------------------------------------------------------------
# Server-only variables (NEVER exposed to the browser)
# ------------------------------------------------------------------------

# Secret key of the Stellar account that signs payments.
# Optional for now (the payment flow is not yet wired to the backend).
# Must be a Stellar secret seed (Starts with "S", 56 characters).
# Never prefix this with NEXT_PUBLIC_.
STELLAR_SECRET_KEY=
