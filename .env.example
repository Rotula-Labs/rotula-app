# Environment example for Rotula.
# Copy this file to .env.local (or .env.development) and fill in real values.
# Real environment files are ignored by git; this example is tracked.

# NODE/ENV runtime mode. Public (safe to commit).
# One of: development | test | production. Defaults if unset: development.
NODE_ENV=development

# Signing secret required by B3. SECRET -- never commit a real value.
# Use a long random string, e.g. generated with: openssl rand -hex 32
ROTULA1_SIGNING_SECRET=replace-with-a-random-secret

# Public base URL of the app validated by B19. Public (safe to commit).
# Must be an absolute http(s) URL with no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public API base URL validated by B19. Public (safe to commit).
# Must be an absolute http(s) URL with no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
